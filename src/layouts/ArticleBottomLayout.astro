---
import { type CollectionEntry, getCollection } from "astro:content"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

// Get the requested entry
const { entry } = Astro.props
const { collection } = entry
const { Content, headings } = await entry.render()

// Table of contents: h2/h3 only
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)

// Get the next and prev entries (modulo to wrap index)
const items = (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex(x => x.slug === entry.slug)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<!-- Reading progress bar -->
<div id="reading-progress" class="fixed top-0 left-0 h-[2px] bg-accent z-[60] w-0" aria-hidden="true"></div>

<!-- Table of contents (wide screens only) -->
{toc.length > 1 &&
  <nav id="toc" aria-label="Table of contents" class="hidden xl:block fixed right-8 top-36 w-56">
    <div class="mono-label mb-3">[ On this page ]</div>
    <ul class="border-l border-black/10 dark:border-white/15">
      {toc.map((h) => (
        <li style={`padding-left: ${(h.depth - 2) * 12}px`}>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class="toc-link block py-1 pl-3 -ml-px border-l border-transparent text-xs opacity-60 hover:opacity-100 text-black dark:text-white transition-opacity duration-200"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
}

<div>
  <article>
    <Content/>
  </article>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <a href={`/${prev.collection}/${prev.slug}`} class="spotlight-card group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 blend">
      <div class="order-2 w-full h-full group-hover:text-black group-hover:dark:text-white blend">
        <div class="flex flex-wrap gap-2">
          <div class="mono-label-plain text-xs uppercase">
            Prev
          </div>
        </div>
        <div class="font-display font-semibold mt-3 text-black dark:text-white">
          {prev.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="order-1 stroke-current group-hover:stroke-black group-hover:dark:stroke-white rotate-180">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
    <a href={`/${next.collection}/${next.slug}`} class="spotlight-card group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
      <div class="w-full h-full text-right group-hover:text-black group-hover:dark:text-white blend">
        <div class="mono-label-plain text-xs uppercase">
          Next
        </div>
        <div class="font-display font-semibold mt-3 text-black dark:text-white">
          {next.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
      </svg>
    </a>
  </div>
</div>

<script is:inline>
  function initArticleEnhancements() {
    // Reading progress
    const bar = document.getElementById("reading-progress")
    if (bar) {
      const updateProgress = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight
        const pct = total > 0 ? Math.min(window.scrollY / total, 1) : 0
        bar.style.width = `${pct * 100}%`
      }
      document.addEventListener("scroll", updateProgress, { passive: true })
      updateProgress()
    }

    // TOC scroll-spy
    const links = Array.from(document.querySelectorAll("[data-toc-link]"))
    if (links.length > 0) {
      const byId = new Map()
      links.forEach((l) => byId.set(l.dataset.tocLink, l))
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              links.forEach((l) => l.classList.remove("toc-active"))
              byId.get(en.target.id)?.classList.add("toc-active")
            }
          })
        },
        { rootMargin: "-15% 0px -70% 0px" },
      )
      byId.forEach((_, id) => {
        const heading = document.getElementById(id)
        if (heading) observer.observe(heading)
      })
    }
  }

  document.addEventListener("astro:after-swap", initArticleEnhancements)
  initArticleEnhancements()
</script>
