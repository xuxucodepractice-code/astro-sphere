---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import LaboratoryMap from "@components/LaboratoryMap.astro"
import { SITE, SOCIALS } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const trajectory = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- Light Mode: Particles -->
  <div class='absolute inset-0 block dark:hidden'>
    <div id='particles1' class='fixed inset-0'></div>
    <div id='particles2' class='fixed inset-0'></div>
    <div id='particles3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Stars -->
  <div class='absolute inset-0 bg-black hidden dark:block'>
    <div id='stars1' class='fixed inset-0'></div>
    <div id='stars2' class='fixed inset-0'></div>
    <div id='stars3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Twinkling Stars / Metors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <script is:inline src="/js/bg.js"></script>

  <!-- [ 00 ] HERO -->
  <section class="relative h-screen w-full">
    <div id="planetcont" class='animate absolute inset-0 top-1/4 overflow-hidden'>
      <div id="crescent" class='absolute top-0 left-1/2 -translate-x-1/2 w-[250vw] min-h-[100vh] aspect-square rounded-full p-[1px] bg-gradient-to-b from-black/25 dark:from-white/75 from-0% to-transparent to-5%'>
        <div id="planet" class='w-full h-full bg-white dark:bg-black rounded-full p-[1px] overflow-hidden flex justify-center'>
          <div id="blur" class='w-full h-20 rounded-full bg-neutral-900/25 dark:bg-white/25 blur-3xl'/>
        </div>
      </div>
    </div>
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center'>
          <p class='animated mono-label'>
            Hello, I am ...
          </p>
          <p class='animated font-display text-3xl md:text-4xl lg:text-5xl font-semibold uppercase text-black dark:text-white mt-2'>
            ZIJIAN XU 徐子健
          </p>
          <p class='animated text-sm md:text-base lg:text-lg opacity-75 mt-4 max-w-2xl mx-auto min-h-[3.5rem]'>
            <span id="hero-question" data-text="I study AI decision systems under uncertainty: how models represent state, reason across signals, and support reliable action in dynamic environments."></span><span id="hero-caret" class="hero-caret" aria-hidden="true"></span>
          </p>
          <p class='animated text-sm md:text-base lg:text-lg opacity-75 mt-2 max-w-2xl mx-auto'>
            MSc Quantitative Finance and FinTech @ PolyU | Finance as a rigorous testbed for AI, robotics, recommender systems, and agentic AI.
          </p>
          <div id="ctaButtons" class='animated flex flex-wrap gap-4 justify-center mt-5'>
            <a href='/projects' class='btn-accent py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base blend'>
              Explore research
            </a>
            <a href='/work' class='py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend'>
              Academic trajectory
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative">
    <div class="mx-auto max-w-screen-sm p-5 space-y-24 pb-16">

      <!-- [ 01 ] THE QUESTION -->
      <section class="animate">
        <div class="space-y-4">
          <div class="section-rule">
            <p class="mono-label">[ 01 ] The Question</p>
          </div>
          <p class="font-display text-xl md:text-2xl text-black dark:text-white leading-snug">
            How can we build AI systems that reason over multiple signals, maintain stable internal states, and make robust decisions in dynamic environments?
          </p>
          <p>
            I'm an MSc Quantitative Finance and FinTech student at <b>PolyU</b>, preparing for
            PhD research on <b>AI decision systems under uncertainty</b>. The through-line in my
            work is sequential decision-making: how a system observes noisy signals, maintains
            useful state, evaluates risk, and turns predictions into reliable actions.
          </p>
          <p>
            Finance is my current laboratory because it is time-dependent, high-stakes, and
            difficult to validate honestly. The same structure also appears in robotics,
            recommender systems, and agentic AI: models must act with incomplete information,
            delayed feedback, and changing environments.
          </p>
          <p>
            My recent projects explore leakage-safe financial forecasting, industrial CTR
            prediction, and reproducible stock-selection pipelines. Alongside the technical work,
            I train consistently, maintain research notes in Obsidian, and study history and
            philosophy as a way to think more clearly about systems over time.
          </p>
          <a href="/about" class="accent-link group flex gap-1 items-center underline decoration-[.5px] underline-offset-2 text-black dark:text-white blend w-fit">
            <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
              Read the full background
            </span>
          </a>
        </div>
      </section>

      <!-- [ 02 ] THE LABORATORIES -->
      <section class="animate">
        <div class="space-y-4">
          <div class="section-rule">
            <p class="mono-label">[ 02 ] The Laboratories</p>
          </div>
          <p>
            I see these areas as different laboratories for the same deeper problem:
            reliable decision-making under uncertainty.
          </p>
          <LaboratoryMap />
        </div>
      </section>

      <!-- [ 03 ] THE TRAJECTORY -->
      <section class="animate">
        <div class="space-y-6">
          <div class="section-rule">
            <p class="mono-label">[ 03 ] The Trajectory</p>
          </div>
          <ul>
            {trajectory.map((entry) => (
              <li class="relative pl-7 pb-7 last:pb-0 border-l border-black/10 dark:border-white/15">
                <span class="absolute -left-[4.5px] top-1.5 size-2 rounded-full bg-accent"></span>
                <div class="mono-label-plain text-xs opacity-60">
                  {entry.data.dateLabel}
                </div>
                <div class="font-display font-semibold text-black dark:text-white mt-1">
                  {entry.data.company}
                </div>
                <div class="text-sm">
                  {entry.data.role}
                </div>
              </li>
            ))}
          </ul>
          <a href="/work" class="accent-link group flex gap-1 items-center underline decoration-[.5px] underline-offset-2 text-black dark:text-white blend w-fit">
            <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
              Full academic trajectory
            </span>
          </a>
        </div>
      </section>

      <!-- [ 04 ] SELECTED WRITING -->
      <section class="animate">
        <div class="space-y-4">
          <div class="section-rule">
            <p class="mono-label">[ 04 ] Selected Writing</p>
          </div>
          <div class="flex justify-between items-baseline">
            <p class="font-display font-semibold text-black dark:text-white">
              Recent posts
            </p>
            <a href="/blog" class="accent-link w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] underline-offset-2 text-black dark:text-white blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All posts
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {posts.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>

          <div class="flex justify-between items-baseline pt-6">
            <p class="font-display font-semibold text-black dark:text-white">
              Recent projects
            </p>
            <a href="/projects" class="accent-link w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] underline-offset-2 text-black dark:text-white blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All projects
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- [ 05 ] CONNECT -->
      <section class="animate">
        <div class="space-y-4">
          <div class="section-rule">
            <p class="mono-label">[ 05 ] Connect</p>
          </div>
          <p class="font-display font-semibold text-black dark:text-white">
            Let's Connect
          </p>
          <p>
            Reach out to me via email or on social media.
          </p>
          <div class="grid grid-cols-4 gap-y-2 mt-4 auto-cols-min">
            {SOCIALS.map(social => (
              <div class="col-span-1 flex items-center gap-1">
                <span class="whitespace-nowrap truncate mono-label-plain text-xs opacity-60">
                  {social.NAME}
                </span>
              </div>
              <div class="col-span-3 truncate">
                <a href={social.HREF} target="_blank" class="accent-link w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] underline-offset-2 text-black dark:text-white blend">
                  <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                    {social.TEXT}
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .hero-caret {
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.1em;
    background-color: rgb(var(--accent));
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-caret { display: none; }
  }
</style>

<script is:inline>
  function initHeroTypewriter() {
    const el = document.getElementById("hero-question")
    if (!el) return
    const full = el.dataset.text || ""

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = full
      return
    }

    el.textContent = ""
    let i = 0
    function tick() {
      if (!document.body.contains(el)) return
      if (i <= full.length) {
        el.textContent = full.slice(0, i)
        i += 1
        setTimeout(tick, 16)
      }
    }
    setTimeout(tick, 500)
  }

  document.addEventListener("astro:after-swap", initHeroTypewriter)
  initHeroTypewriter()
</script>
